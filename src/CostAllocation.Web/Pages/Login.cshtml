@page
@model CostAllocation.Web.Pages.LoginModel
@{
    ViewData["Title"] = "Iniciar sesión";
}

<div class="auth-card">
    <h1>Iniciar sesión</h1>
    @if (Model.Error is not null)
    {
        <p class="error">@Model.Error</p>
    }
    <form method="post">
        <input type="hidden" asp-for="ReturnUrl" />
        <label>Correo electrónico</label>
        <input asp-for="Email" type="email" required />
        <label>Contraseña</label>
        <input asp-for="Password" type="password" required />
        <button type="submit">Entrar</button>
    </form>
    <p style="margin-top:14px"><a asp-page="Setup">¿Primera vez? Configuración inicial</a></p>
</div>
