@page
@model CostAllocation.Web.Pages.Unidades.CreateModel
@{
    ViewData["Title"] = "Nueva unidad";
}

<h1>Nueva unidad · @Model.Agrupacion?.Nombre</h1>

<form method="post">
    <input type="hidden" asp-for="AgrupacionId" />

    <label>Código</label>
    <input asp-for="Unidad.Codigo" placeholder="ej. UND-101" required />

    <label>Tipo de unidad</label>
    <select asp-for="Unidad.TipoUnidad">
        <option value="Residencial">Residencial</option>
        <option value="Comercial">Comercial</option>
        <option value="Bodega">Bodega</option>
        <option value="Oficina">Oficina</option>
        <option value="Lote">Lote</option>
    </select>

    <label>Área (m²)</label>
    <input asp-for="Unidad.AreaM2" type="number" step="0.01" />

    <button type="submit">Crear</button>
    <a asp-page="Index" asp-route-agrupacionId="@Model.AgrupacionId">Cancelar</a>
</form>
