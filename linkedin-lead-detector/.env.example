# Google Programmable Search Engine — https://programmablesearchengine.google.com/
# Crear un motor acotado a linkedin.com, habilitar "Search the entire web" = OFF y
# agregar linkedin.com como sitio. La API key sale de Google Cloud Console (Custom Search API).
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=

# Anthropic — https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Telegram — hablar con @BotFather para crear el bot y obtener el token.
# TELEGRAM_CHAT_ID: mandale un mensaje al bot y consultá
# https://api.telegram.org/bot<TOKEN>/getUpdates para ver tu chat_id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Umbral de confianza (0-1) del clasificador LLM para disparar una notificación.
CONFIDENCE_THRESHOLD=0.6

# Ruta de la base SQLite (se crea sola si no existe).
DB_PATH=./leads.db
